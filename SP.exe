void Read_Sensor()
{
 S1=0, S2=0, S3=0, S4=0;
 if(digitalRead(ir_car1) == 0)
 {
  S1=1;
  } //read degital data from IR sensor1
 if(digitalRead(ir_car2) == 0)
 {
  S2=1;
  } //read degital data from IR sensor2
 if(digitalRead(ir_car3) == 0)
 {
  S3=1;
  } // read degital data from IR sensor3
 if(digitalRead(ir_car4) == 0)
 {
  S4=1;
 } // read degital data from IR sensor4

}
